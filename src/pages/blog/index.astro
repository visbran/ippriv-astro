---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogList from '../../components/blog/BlogList';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import { toPostSummary } from '../../utils/blog';
import { countTopics } from '../../utils/topics';

// Get all blog posts
const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

// Sort by date descending
const posts = allPosts.sort((a, b) => 
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// Card fields only: full entries would serialize every article body into the page
const summaries = posts.map(toPostSummary);

// Topic counts for the filter (raw tags are normalized into topics)
const topics = countTopics(summaries.map((s) => s.topics));
---

<Layout
  title="IP Lookup Blog: Geolocation, VPN & Privacy Guides | IPPriv"
  description="Expert articles on IP geolocation, VPN detection, API security, and privacy-first development. Tutorials and guides for developers."
  keywords="ip lookup blog, ip geolocation, VPN detection, API security, privacy development, ip address guides, ip API tutorials"
>
  <BreadcrumbSchema items={[
    { name: 'Home', url: 'https://www.ippriv.com/' },
    { name: 'Blog', url: 'https://www.ippriv.com/blog/' },
  ]} />
  <div class="pt-28 pb-20 md:pt-32">
    <div class="section-container">
      <header class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-foreground">
            IP Lookup & Privacy Blog
          </h1>
          <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
            Guides on IP geolocation, VPN detection, API security, and privacy-first development.
          </p>
        </div>
        <a href="/blog/archive" class="text-sm font-medium text-muted-foreground hover:text-foreground underline underline-offset-4 md:shrink-0">
          Browse the archive
        </a>
      </header>

      {/* Blog List with Search & Filters */}
      <BlogList 
        client:load
        posts={summaries}
        topics={topics}
      />
    </div>
  </div>
</Layout>
