---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection';
import HomeReveals from '../components/HomeReveals.astro';
import HomeFAQ from '../components/HomeFAQ.astro';
import FAQSchema from '../components/FAQSchema.astro';

const homeFAQs = [
  {
    question: "Do you log my IP address?",
    answer: "Requests to IPPriv, including your IP address, are logged to run and protect the service. Those logs are deleted after 30 days unless the law requires us to keep them longer. Site analytics use Plausible, which sets no cookies. Details are in our privacy policy.",
  },
  {
    question: "What information can I get from an IP address?",
    answer: "With IPPriv you can retrieve the country, region, city, latitude/longitude, timezone, ISP, hostname via reverse DNS lookup, and security flags such as whether the IP is a VPN, proxy, Tor exit node, or hosting provider.",
  },
  {
    question: "How accurate is IP geolocation?",
    answer: "Country-level accuracy is typically 95-99%, region/state-level is 55-80%, and city-level is 50-75%. Accuracy depends on how ISPs register their IP blocks in regional databases.",
  },
  {
    question: "Can IPPriv detect VPNs and proxies?",
    answer: "Yes. IPPriv's security check analyzes each IP address and returns flags for VPN usage, proxy servers, Tor exit nodes, and hosting/datacenter IPs in real time.",
  },
  {
    question: "What does \"Data center IP\" mean?",
    answer: "The address belongs to a hosting or cloud provider rather than a home or mobile network. VPNs and proxies usually run from data centers, so websites often treat these addresses as masked traffic.",
  },
  {
    question: "Is IPPriv free to use?",
    answer: "Yes, IPPriv is completely free. You can look up any IP address and access the full geolocation API without registration or authentication.",
  },
  {
    question: "Do I need an API key to use the IPPriv API?",
    answer: "No API key is required. The IPPriv API is open and free. Send a GET request to api.ippriv.com with the IP address you want to look up.",
  },
];
---

<Layout
  title="IP Lookup Tool: Free IP Address Information | IPPriv"
  description="Free IP lookup tool. Instantly get information on any IP address: geolocation, ISP, VPN detection, and more. No account required."
  keywords="ip lookup, ip address, ip, ip address information, ip address lookup, free ip lookup, ip geolocation, VPN detection, proxy detection, ISP lookup"
>
  <FAQSchema faqs={homeFAQs} />
  
  <HeroSection client:load />
  <HomeReveals />
  <HomeFAQ faqs={homeFAQs} />
</Layout>
