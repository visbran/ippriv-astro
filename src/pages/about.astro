---
import Layout from '../layouts/Layout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import { Github, Globe } from 'lucide-react';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://www.ippriv.com/about#author',
  name: 'Brandon Visca',
  url: 'https://brandonvisca.com',
  jobTitle: 'President, LMF Solutions',
  worksFor: { '@type': 'Organization', name: 'LMF Solutions' },
  sameAs: ['https://github.com/visbran', 'https://twitter.com/brandonvisca', 'https://brandonvisca.com'],
};

const sources = [
  { what: 'Geolocation', how: 'ip-api.com, with ipapi.co as a fallback' },
  { what: 'VPN, proxy, Tor and hosting detection', how: 'IPQualityScore' },
  { what: 'Reverse DNS (PTR records)', how: 'DNS over HTTPS through Cloudflare, with Google as a fallback' },
  { what: 'API hosting', how: 'Cloudflare Workers, rate limited to 100 requests per hour per IP' },
];
---

<Layout
  title="About IPPriv - Who Builds It and How It Works"
  description="IPPriv is a free IP lookup tool and API published by LMF Solutions. How lookups work, where the data comes from, what we keep, and who writes the blog."
  keywords="about IPPriv, IP lookup data sources, Brandon Visca, LMF Solutions"
>
  <BreadcrumbSchema items={[
    { name: 'Home', url: 'https://www.ippriv.com/' },
    { name: 'About', url: 'https://www.ippriv.com/about/' },
  ]} />
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} slot="head" />

  <div class="pt-28 pb-20 md:pt-32">
    <div class="section-container">
      <header class="max-w-2xl mb-12">
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-foreground">About IPPriv</h1>
        <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
          IPPriv is a free IP lookup tool and API. It shows what an IP address reveals: location, network, reverse
          DNS, and whether it belongs to a VPN, proxy, Tor or hosting network.
        </p>
      </header>

      <div class="max-w-3xl content-body">
        <section>
          <h2>Why it exists</h2>
          <p>
            Every site you visit sees your IP address. Most people never check what that address says about them, and
            most IP tools bury the answer under ads and sign-up walls. IPPriv answers the question in one screen, with
            no account and no ads, and explains the results in plain language on the <a href="/blog">blog</a>.
          </p>
        </section>

        <section>
          <h2>Where the data comes from</h2>
          <p>A lookup combines several sources. Results are estimates, not ground truth.</p>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Data</th><th>Source</th></tr></thead>
              <tbody>
                {sources.map((s) => (
                  <tr><td>{s.what}</td><td>{s.how}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>
            Country is usually right; city-level location is often off by tens of kilometers, and detection signals
            can be wrong. Public resolvers such as 8.8.8.8, for example, show up as hosting and proxy addresses.
          </p>
        </section>

        <section>
          <h2>What we keep</h2>
          <p>
            No accounts, no cookies, no advertising. API logs are deleted after 30 days at most, and rate-limit counters
            after one hour. The <a href="/privacy">privacy policy</a> lists every provider involved.
          </p>
        </section>
      </div>

      <section id="author" class="mt-16 max-w-3xl scroll-mt-24 rounded-lg border border-border bg-card p-6 sm:p-8">
        <h2 class="text-xl font-semibold tracking-tight text-foreground">Who is behind it</h2>
        <p class="mt-3 text-foreground/85 leading-relaxed">
          IPPriv is built and run by <strong class="font-semibold text-foreground">Brandon Visca</strong>, President of
          LMF Solutions, the company that publishes the site. He maintains the tool, the API and the blog, and writes
          about self-hosting and infrastructure on his own site.
        </p>
        <ul class="mt-5 flex flex-wrap gap-2">
          <li>
            <a href="https://brandonvisca.com" target="_blank" rel="noopener noreferrer me"
               class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-sm text-foreground hover:bg-secondary transition-colors">
              <Globe class="w-4 h-4" /> brandonvisca.com
            </a>
          </li>
          <li>
            <a href="https://github.com/visbran" target="_blank" rel="noopener noreferrer me"
               class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-sm text-foreground hover:bg-secondary transition-colors">
              <Github class="w-4 h-4" /> GitHub
            </a>
          </li>
        </ul>
      </section>

      <p class="mt-10 max-w-3xl text-muted-foreground">
        Questions, corrections or partnership ideas: use the <a href="/contact" class="text-primary underline underline-offset-4">contact form</a>.
      </p>
    </div>
  </div>
</Layout>
