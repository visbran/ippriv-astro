---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Most-read articles (Search Console, July to October 2026)
const popularSlugs = [
  'what-is-a-datacenter-ip-address',
  'how-to-hide-ip-address-mobile',
  'dns-over-https-vs-dns-over-tls',
  'webrtc-ip-leak-explained',
];
const posts = await getCollection('blog', ({ data }) => data.draft !== true);
const popular = popularSlugs
  .map((slug) => posts.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Layout
  title="404 - Page Not Found | IPPriv"
  description="The page you're looking for doesn't exist. Return to IPPriv home."
>
  <div class="pt-28 pb-20 md:pt-32">
    <div class="section-container">
      <div class="max-w-2xl">
        <p class="font-mono text-sm text-primary">404</p>
        <h1 class="mt-2 text-4xl md:text-5xl font-semibold tracking-tight text-foreground">Page not found</h1>
        <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
          This page does not exist or has moved. The link may be old, or the address mistyped.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="/ip-lookup"
            class="inline-flex items-center justify-center px-5 py-3 text-[15px] font-medium rounded-md bg-primary text-primary-foreground hover:bg-primary/90 active:translate-y-px transition-colors"
          >
            Try IP Lookup
          </a>
          <a
            href="/blog"
            class="inline-flex items-center justify-center px-5 py-3 text-[15px] font-medium rounded-md border border-border text-foreground hover:bg-secondary active:translate-y-px transition-colors"
          >
            Browse the blog
          </a>
        </div>
      </div>

      {popular.length > 0 && (
        <section class="mt-16 max-w-2xl" aria-labelledby="popular-heading">
          <h2 id="popular-heading" class="text-sm font-medium text-foreground">Popular articles</h2>
          <ul class="mt-3 divide-y divide-border border-y border-border">
            {popular.map((post) => (
              <li>
                <a href={`/blog/${post.slug}`} class="block py-3.5 text-foreground hover:text-primary transition-colors">
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Layout>
