---
// "Now what?" block under the homepage readout: each row maps to a line of
// the readout card and points to the article that explains it.
const reveals = [
  {
    term: 'Your approximate location',
    body: "Usually the right country, often the right region, sometimes the right city. It points to your provider's equipment, not your street.",
    href: '/blog/ip-address-location-accuracy',
    link: 'How accurate IP location is',
  },
  {
    term: 'Your internet provider',
    body: 'The company that connects you, named in the lookup above. Your provider also sees every address you connect to.',
    href: '/blog/how-isps-track-you-via-ip',
    link: 'How ISPs track you through your IP',
  },
  {
    term: 'Whether you use a VPN or proxy',
    body: 'Sites can tell when a connection comes from a VPN, a proxy, Tor or a data center, and some of them block it.',
    href: '/blog/vpn-detection-explained',
    link: 'How VPN detection works',
  },
];
---

<section id="what-it-reveals" class="border-t border-border py-16 sm:py-20">
  <div class="section-container">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">What your IP address reveals</h2>
      <p class="mt-3 text-lg text-muted-foreground">
        Websites, ad networks and your internet provider read it on every request. Three things travel with it.
      </p>

      <dl class="mt-10 divide-y divide-border border-y border-border">
        {reveals.map((r) => (
          <div class="grid gap-2 py-6 sm:grid-cols-[13rem_1fr] sm:gap-8">
            <dt class="font-semibold text-foreground">{r.term}</dt>
            <dd class="text-muted-foreground">
              {r.body}{' '}
              <a href={r.href} class="font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">
                {r.link}
              </a>
            </dd>
          </div>
        ))}
      </dl>

      <p class="mt-8 text-foreground">
        Want to keep it private?{' '}
        <a href="/blog/hide-your-ip-address" class="font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">
          How to hide your IP address
        </a>
      </p>
    </div>
  </div>
</section>
