---
interface Props {
  title: string;
  updated: string;
  toc?: { id: string; label: string }[];
}

const { title, updated, toc = [] } = Astro.props;
---

<div class="pt-28 pb-20 md:pt-32">
  <div class="section-container">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-16">
      <article class="min-w-0 max-w-3xl">
        <header class="mb-10">
          <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-foreground">{title}</h1>
          <p class="mt-4 text-sm text-muted-foreground">Last updated: {updated}</p>
        </header>

        {toc.length > 0 && (
          <nav aria-label="Contents" class="mb-12 rounded-lg border border-border bg-card p-5 lg:hidden">
            <p class="text-sm font-medium text-foreground">Contents</p>
            <ol class="mt-3 space-y-1.5 text-sm">
              {toc.map((item) => (
                <li><a href={`#${item.id}`} class="text-muted-foreground hover:text-foreground">{item.label}</a></li>
              ))}
            </ol>
          </nav>
        )}

        <div class="content-body">
          <slot />
        </div>
      </article>

      {toc.length > 0 && (
        <nav aria-label="Contents" class="hidden lg:block">
          <div class="sticky top-24">
            <p class="text-sm font-medium text-foreground">Contents</p>
            <ol class="mt-3 space-y-1 border-l border-border text-sm">
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} class="-ml-px block border-l border-transparent py-1 pl-3 text-muted-foreground hover:border-foreground/40 hover:text-foreground transition-colors">
                    {item.label}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )}
    </div>
  </div>
</div>
